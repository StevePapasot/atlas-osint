# ATLAS OSINT — configuration template
#
# Copy to .env (never commit .env) and fill in only what you need. Every variable is optional: with nothing set,
# ATLAS runs locally on SQLite with offline analysers, keyless public sources and the simulated demo providers.
# Secret values are read only on the server; the UI shows whether a key is present, never its value.

# --------------------------------------------------------------------------------------------- core
# SQLite file (default: file:./data/atlas.db) or PostgreSQL / Supabase connection string, e.g.
#   postgres://user:password@host:5432/atlas
# For Supabase use the direct or session-pooler connection string of a server-side role, never the anon key.
# Leave DATABASE_URL and ATLAS_DATA_DIR commented out when using this file with Docker (`--env-file .env`):
# the image stores everything in its /data volume.
# DATABASE_URL=file:./data/atlas.db
# Directory for uploaded files (images, documents) and the default SQLite database (default: ./data).
# ATLAS_DATA_DIR=./data
# Public base URL of the app. Used as an allowed Origin for state-changing requests behind proxies.
ATLAS_APP_URL=http://localhost:3000
# Where users of this instance can get its source code (linked in every page footer). ATLAS is AGPL-3.0: if you run a
# MODIFIED version for other people, point this at your modified source. Default: the upstream repository.
# ATLAS_SOURCE_URL=https://github.com/StevePapasot/atlas-osint
# Number of reverse proxies in front of the app that append to X-Forwarded-For (0 = exposed directly).
# Used for per-IP rate limiting; set to 1 behind a single nginx/Caddy/Traefik that sets X-Forwarded-For.
ATLAS_TRUSTED_PROXY_HOPS=0
# Apply migrations automatically on first request (default true). Set false and run `npm run db:migrate` in CI/CD.
ATLAS_AUTO_MIGRATE=true
# Max PostgreSQL pool size per process.
ATLAS_PG_POOL_MAX=10

# --------------------------------------------------------------------------------------------- auth & security
# Session lifetime in hours (default 168 = 7 days).
ATLAS_SESSION_TTL_HOURS=168
# Mark the session cookie Secure. Defaults to true in production (NODE_ENV=production). Set false only for plain
# HTTP on localhost.
# ATLAS_COOKIE_SECURE=true
# Allow self-registration (default true). The first account becomes admin. Set false after creating accounts.
ATLAS_ALLOW_REGISTRATION=true
# Send Strict-Transport-Security (enable only when served exclusively over HTTPS).
# ATLAS_ENABLE_HSTS=true
# Salt for the one-way hash of client IPs stored in audit events. Set a random value in production.
# ATLAS_IP_HASH_SALT=change-me
# Optional Redis for shared rate-limit counters across instances (in-memory per process if unset).
# REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------------------------- jobs
# Run the job worker inside the web process (default true). Set false and run `npm run worker` separately to scale
# workers independently.
ATLAS_INPROCESS_WORKER=true
# Concurrent investigations per worker process.
ATLAS_WORKER_JOB_CONCURRENCY=2
# Concurrent provider tasks within one investigation.
ATLAS_TASK_CONCURRENCY=4
# Default per-request provider timeout in ms.
ATLAS_PROVIDER_TIMEOUT_MS=15000
# Comma-separated provider ids disabled for every user (e.g. "reddit,ahmia").
# ATLAS_DISABLED_PROVIDERS=

# --------------------------------------------------------------------------------------------- collection behaviour
# Maximum upload size in MB (images and documents).
ATLAS_MAX_UPLOAD_MB=20
# Offline OCR with tesseract.js (default true).
ATLAS_ENABLE_OCR=true
# Opt-in: fetch URL targets once (title, metadata, contacts, links). Notifies the site operator that the URL was
# visited. Requests are SSRF-guarded: public addresses only, every redirect re-validated.
ATLAS_ALLOW_TARGET_FETCH=false
# Custom DNS resolvers for the DNS providers (comma-separated IPs). System resolver if unset.
# ATLAS_DNS_SERVERS=1.1.1.1,9.9.9.9
# User-Agent sent to sources.
ATLAS_HTTP_USER_AGENT=ATLAS-OSINT/0.1 (+passive public-source research)
# Default retention in days for investigations not updated within the window (0 = keep forever). Users can set
# their own in Settings → Data retention. Purges run hourly in the worker.
ATLAS_DEFAULT_RETENTION_DAYS=0
# RDAP bootstrap/base URL override (default https://rdap.org).
# ATLAS_RDAP_BASE_URL=https://rdap.org
# Development only: allow requests to private addresses and non-standard ports (never enable in production).
# ATLAS_ALLOW_PRIVATE_EGRESS=false
# Ignore HTTPS_PROXY/HTTP_PROXY for provider traffic (direct connections with socket-level SSRF guard).
# ATLAS_IGNORE_PROXY=false

# --------------------------------------------------------------------------------------------- search providers
# Brave Search API — https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# SerpApi (Google results, reverse image search by public URL) — https://serpapi.com/
SERPAPI_API_KEY=
# Parallel Search API — https://parallel.ai/
PARALLEL_API_KEY=

# --------------------------------------------------------------------------------------------- username / social
# GitHub token (no scopes needed) — raises rate limits and enables email search. https://github.com/settings/tokens
GITHUB_TOKEN_OSINT=
# YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Mastodon instances checked for a username (comma-separated).
ATLAS_MASTODON_INSTANCES=mastodon.social,fosstodon.org,infosec.exchange

# --------------------------------------------------------------------------------------------- email / breach
# Have I Been Pwned API v3 key (paid subscription) — https://haveibeenpwned.com/API/Key
# Only the documented breachedaccount endpoint is used. No passwords are ever queried or stored.
HIBP_API_KEY=

# --------------------------------------------------------------------------------------------- IP / domain / reputation
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
# IPinfo works without a token at low volume; a token raises limits.
IPINFO_TOKEN=

# --------------------------------------------------------------------------------------------- crypto
ETHERSCAN_API_KEY=

# --------------------------------------------------------------------------------------------- dark-web research
# Only indexes reachable over the clear web; ATLAS never connects to Tor or hidden services itself, and never
# purchases, downloads or trades data.
# Ahmia clearnet search (opt-in).
ATLAS_ENABLE_AHMIA=false
# Intelligence X — https://intelx.io/account?tab=developer
INTELX_API_KEY=
INTELX_API_URL=https://free.intelx.io
# Your organisation's authorised index (JSON search endpoint). See docs/PROVIDERS.md for the contract.
ATLAS_DARKWEB_INDEX_URL=
ATLAS_DARKWEB_INDEX_TOKEN=

# --------------------------------------------------------------------------------------------- geo
# Online geocoding via OpenStreetMap Nominatim (opt-in; respect the usage policy). Offline gazetteer is always on.
ATLAS_ENABLE_NOMINATIM=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Raster tile URL template for maps. Default: OpenStreetMap's tile server (heavy use must follow its tile usage
# policy — use your own tile server or a commercial provider in production). When tiles cannot load, an offline
# world basemap is shown instead.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --------------------------------------------------------------------------------------------- AI-assisted analysis (optional)
# Anthropic API key. Every AI statement must cite stored findings; uncited statements are discarded.
ANTHROPIC_API_KEY=
ATLAS_AI_MODEL=claude-opus-5-5
ATLAS_AI_BASE_URL=https://api.anthropic.com

# --------------------------------------------------------------------------------------------- logging & demo
# debug | info | warn | error
ATLAS_LOG_LEVEL=info
# Demo seed account (npm run db:seed).
ATLAS_DEMO_EMAIL=demo@atlas-osint.local
ATLAS_DEMO_PASSWORD=atlas-demo-2026
# Set false to create only the demo account, without the sample investigation.
# ATLAS_SEED_INVESTIGATION=true
# Skip the simulated latency of demo providers (tests).
# ATLAS_DEMO_FAST=false

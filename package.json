    "setup": "npm run db:migrate && npm run db:seed",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "providers:check": "tsx --conditions=react-server scripts/providers-check.ts"
